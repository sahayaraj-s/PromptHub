rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──
    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── PROMPTS ──
    match /prompts/{promptId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        // Allow incrementing views/likes/copies/saves/comments
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['views','likes','copies','saves','comments','updatedAt']));
      allow delete: if isAdmin();
    }

    // ── CATEGORIES ──
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── LIKES ──
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuth();
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── SAVED ──
    match /saved/{savedId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── COMMENTS ──
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;    // Allow anonymous comments
      allow update, delete: if isAdmin();
    }

    // ── USERS ──
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── ADMINS ──
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Only via Firebase Console
    }

    // ── CONTACTS ──
    match /contacts/{contactId} {
      allow create: if true;   // Anyone can send contact messages
      allow read, update, delete: if isAdmin();
    }
  }
}
